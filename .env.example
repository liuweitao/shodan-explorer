# The existing shodan-proxy v1.0.3 recognizes this public compatibility marker.
# Do not put a real Shodan API key here for a publicly reachable web deployment.
SHODAN_API_KEY=shodanproxy
SHODAN_BASE_URL=http://shodan-proxy:8080

SHODAN_EXPLORER_BIND_ADDRESS=127.0.0.1
SHODAN_EXPLORER_PORT=8080
SHODAN_PROXY_ADMIN_PORT=8081

# Optional release override. Prefer an immutable version or digest in production.
# SHODAN_EXPLORER_IMAGE=liuweitao/shodan-explorer:2.0.0
